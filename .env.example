# Environment Variables
# Copy this file to .env and update with your actual values

# Database paths (optional - defaults to data/ directory)
# PROPERTIES_DB=data/properties.db
# DEALS_DB=data/deals.db
# DEVELOPERS_DB=data/developers.db

# Email configuration (for notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your.email@gmail.com
# EMAIL_PASSWORD=your_app_password

# API Keys (if you integrate with real estate APIs)
# ZILLOW_API_KEY=your_zillow_api_key
# COUNTY_RECORDS_API_KEY=your_county_api_key

# Notification settings
# SEND_EMAIL_NOTIFICATIONS=true
# NOTIFY_ON_NEW_OPPORTUNITIES=true
# NOTIFY_ON_DEAL_STATUS_CHANGE=true
